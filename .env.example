# ---------------------------------------------------------------------------
# wknd-next: single source of configuration.
# Copy to .env.local (or set in Vercel project env). Nothing else in the
# codebase reads process.env directly; src/lib/aem-config.ts is the one reader.
# Every value is optional: unset values fall back to the XSC Showcase demo.
# ---------------------------------------------------------------------------

# AEM author origin. Used for the Universal Editor connection meta tag.
# No trailing slash.
AEM_AUTHOR=https://author-p<program>-e<env>.adobeaemcloud.com

# AEM publish origin. Every content read (CF Delivery API) comes from here.
# No trailing slash.
AEM_PUBLISH=https://publish-p<program>-e<env>.adobeaemcloud.com

# DAM folder that contains the app's five fragment folders:
#   promotions/  personas/  adventures/  field-notes/  alerts/
AEM_DAM_ROOT=/content/dam/wknd-next/en

# Optional. Bearer token, only if your publish tier is NOT publicly readable.
# Leave blank for a normal sandbox.
AEM_TOKEN=

# Optional. Adobe Fonts (Typekit) kit id. The WKND fonts are already
# self-hosted from /public/fonts, so this is normally blank.
NEXT_PUBLIC_FONT_KIT=
